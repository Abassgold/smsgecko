# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Origin allowed to call the API with credentials (the web app).
WEB_ORIGIN=http://localhost:3000

# --- Database ---
# The app reads MONGODB_URI. Local single-node replica set (docker-compose / npm run db:mem):
MONGODB_URI=mongodb://localhost:27017/smsgecko?replicaSet=rs0&directConnection=true
# Or MongoDB Atlas (put real credentials only in .env, which is gitignored):
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/smsgecko?retryWrites=true&w=majority
# Optional, not yet used by the app — a separate store for logs:
# MONGO_LOGS_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/smsgecko_logs?retryWrites=true&w=majority
# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Cookie domain/secure — leave COOKIE_SECURE=false for http localhost.
COOKIE_SECURE=false

# AES-256-GCM key (base64, 32 bytes) for encrypting provider credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENC_KEY=dev-settings-enc-key-change-me

# --- Email (Amazon SES) ---
# Unset -> verification links are logged instead of sent (fine for local dev / tests).
# SMTP settings > Create SMTP credentials in the SES console (IAM user scoped to ses:SendRawEmail only).
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
# Sender address. Must be a verified identity/domain in SES, or sends are rejected, and should be a
# monitored inbox (AWS advises against no-reply senders).
EMAIL_FROM=SMSGecko <support@smsgecko.com>
# ARN of the SNS topic SES publishes bounce/complaint notifications to (SES console > Verified
# identities > smsgecko.com > Notifications). POST /api/v1/ses/notifications rejects any other
# topic, and returns 503 while this is unset.
SES_SNS_TOPIC_ARN=
# Base URL the verification link points at (the web app).
APP_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_MINUTES=5

# --- Payments ---
# Every deposit method requires its own gateway's credentials below — there
# is no mock/fallback payment path. A method whose gateway is unconfigured
# is simply unavailable (the API returns a clear error rather than a fake
# instant "payment").
# Order time-to-live before auto-expiry + refund. Use 60 in dev to see refunds fast.
ORDER_TTL_SECONDS=1200

# Stripe (test mode) — cards. https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/test/webhooks (or `stripe listen` in dev) — the
# endpoint is POST {API_PUBLIC_URL}/api/v1/webhooks/payments/stripe
STRIPE_WEBHOOK_SECRET=

# NowPayments (sandbox) — crypto (USDT).
# https://account.nowpayments.io/api-keys (sandbox: account-sandbox.nowpayments.io)
NOWPAYMENTS_API_KEY=
# IPN secret from the same dashboard, used to verify the x-nowpayments-sig header.
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

# Bachs (sandbox by default) — African bank transfer & mobile money across
# Nigeria, Ghana, Kenya, Uganda, Tanzania and more. Bachs prices every
# checkout in USD and converts to whichever corridor the customer picks on
# their own hosted page — no admin-maintained FX rate table needed.
# https://bachs.io dashboard > Developer Portal > API keys / Webhooks
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_SANDBOX=true

# Cryptomus — a second crypto processor. https://app.cryptomus.com (Settings > API)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# Public base URL of this API (not the web app) — used to build the
# NowPayments/Bachs/Cryptomus webhook callback URLs. Needs to be reachable
# from the internet in dev (e.g. an ngrok/cloudflared tunnel) for real
# webhook delivery to work.
API_PUBLIC_URL=http://localhost:4000

# --- Workers ---
WORKERS_ENABLED=true
