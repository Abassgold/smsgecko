# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Origin allowed to call the API with credentials (the web app).
WEB_ORIGIN=http://localhost:3000

# --- Database ---
# The app reads MONGODB_URI. Local single-node replica set (docker-compose / npm run db:mem):
MONGODB_URI=mongodb://localhost:27017/smsgecko?replicaSet=rs0&directConnection=true
# Or MongoDB Atlas (put real credentials only in .env, which is gitignored):
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/smsgecko?retryWrites=true&w=majority
# Optional, not yet used by the app — a separate store for logs:
# MONGO_LOGS_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/smsgecko_logs?retryWrites=true&w=majority
# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Cookie domain/secure — leave COOKIE_SECURE=false for http localhost.
COOKIE_SECURE=false

# AES-256-GCM key (base64, 32 bytes) for encrypting provider credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENC_KEY=dev-settings-enc-key-change-me

# --- Email (Resend) ---
# Unset -> verification links are logged instead of sent (fine for local dev / tests).
RESEND_API_KEY=
# Sender address. The default (onboarding@resend.dev) is Resend test mode and only
# delivers to the Resend account owner. Until SMSGecko has its own verified domain,
# send from the already-verified flozap.com.ng domain so mail reaches real inboxes:
EMAIL_FROM=SMSGecko <noreply@flozap.com.ng>
# Base URL the verification link points at (the web app).
APP_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_HOURS=24

# --- Mock providers ---
PAYMENTS_MOCK=true
# Order time-to-live before auto-expiry + refund. Use 60 in dev to see refunds fast.
ORDER_TTL_SECONDS=1200
# Probability (0..1) that a mock order ever receives an SMS. 0 = always refund.
MOCK_SMS_SUCCESS_RATE=0.8
# Delay window before the mock OTP is delivered.
MOCK_SMS_MIN_DELAY_MS=5000
MOCK_SMS_MAX_DELAY_MS=45000

# --- Workers ---
WORKERS_ENABLED=true
